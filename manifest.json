{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.3.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
  }
}
